# ==============================================================================
# Configurações do Portfólio Técnico Self-Hosted
# Copie este arquivo para ".env" e ajuste os valores antes de subir a aplicação.
# ==============================================================================

# Ambiente: "desenvolvimento" ou "producao"
PORTFOLIO_AMBIENTE=desenvolvimento

# Fuso horário usado nos logs e datas (padrão Brasil: UTC-3)
TZ=America/Sao_Paulo

# Endereço e porta do servidor web
PORTFOLIO_HOST=0.0.0.0
PORTFOLIO_PORTA=8000

# Caminho da pasta onde ficam banco SQLite, mídias e logs (mapeada no Docker)
PORTFOLIO_PASTA_DADOS=dados

# Senha de acesso ao painel administrativo (/config) — TROQUE EM PRODUÇÃO!
PORTFOLIO_SENHA_ADMIN=troque-esta-senha-antes-de-publicar

# Chave secreta usada para assinar cookies de sessão (gere uma string longa e aleatória)
# Exemplo para gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTFOLIO_CHAVE_SECRETA=gere-uma-chave-secreta-longa-e-aleatoria-aqui

# Tempo de duração da sessão administrativa em horas
PORTFOLIO_SESSAO_HORAS=12

# Defina como "true" quando estiver rodando em HTTPS (ex.: atrás do Caddy/Cloudflare)
PORTFOLIO_COOKIE_SEGURO=false

# Proxy reverso (Caddy / Cloudflare)
# Defina como "true" SOMENTE quando a aplicação estiver atrás de proxy confiável
PORTFOLIO_CONFIAR_PROXY=false
# Ordem de cabeçalhos lidos para obter o IP real do cliente quando CONFIAR_PROXY=true
PORTFOLIO_CABECALHO_IP_PROXY=CF-Connecting-IP,X-Forwarded-For

# Proteção contra tentativas repetidas de login no /config
PORTFOLIO_MAX_TENTATIVAS_LOGIN=5
PORTFOLIO_JANELA_BLOQUEIO_SEGUNDOS=300

# Nível de log: DEBUG, INFO, WARNING, ERROR
PORTFOLIO_NIVEL_LOG=INFO

# URL pública base (opcional, usada nas meta tags Open Graph em produção)
# Exemplo: https://portfolio.seudominio.com.br
PORTFOLIO_URL_BASE=

# ==============================================================================
# Notificações por E-mail (SMTP) — Opcional
# Se SMTP_USUARIO e SMTP_SENHA estiverem vazios, os envios ficam desativados.
# No Gmail, use uma "Senha de App" (não a senha principal da conta).
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Se vazio, envia para o próprio SMTP_USUARIO
SMTP_DESTINATARIO=
# Defina como "false" para desligar envios mesmo com credenciais preenchidas
SMTP_ATIVO=true

# Relatório diário de acessos (horário no fuso definido em TZ)
PORTFOLIO_RELATORIO_HORA=21:00
PORTFOLIO_RELATORIO_ENVIAR_SE_ZERADO=false

# IPs ignorados nas métricas de acesso (além do admin logado, que é sempre ignorado)
PORTFOLIO_IPS_IGNORADOS=127.0.0.1,::1

